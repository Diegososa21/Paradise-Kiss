DJANGO_DEBUG=true
DJANGO_USE_SQLITE=false
# Ask the project owner for the shared value. It is required so activation
# links generated on one team laptop also work on another team laptop.
DJANGO_SECRET_KEY=ASK_PROJECT_OWNER_FOR_SHARED_SECRET
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
DJANGO_SECURE_HSTS_SECONDS=0
FRONTEND_URL=http://localhost:4200
PASSWORD_RESET_TIMEOUT=86400
SESSION_COOKIE_AGE=28800
DB_CONN_MAX_AGE=0
DB_POOL_MODE=transaction

# Shared Supabase Transaction Pooler. Only DB_PASSWORD is secret.
DB_NAME=postgres
DB_USER=postgres.pdbvbpkvgsfbdwsbhcxv
DB_PASSWORD=ASK_PROJECT_OWNER_FOR_DATABASE_PASSWORD
DB_HOST=aws-1-eu-west-1.pooler.supabase.com
DB_PORT=6543

# DATABASE_URL can be used instead of the five DB_* variables above.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres?sslmode=require

# Inventory notifications (sale, restock, update, delete, new article) are sent
# to every active user whose email is registered in the Supabase database.
# Without SMTP credentials, development uses Django's console backend and
# prints the messages in the backend terminal.
INVENTORY_EMAIL_NOTIFICATIONS_ENABLED=true
INVENTORY_EMAIL_SUBJECT_PREFIX=[Paradise Kiss Lager]

# Gmail: only the account and an app password (https://myaccount.google.com/apppasswords)
# are needed; smtp.gmail.com and the sender address are filled in automatically.
# EMAIL_HOST_USER=your.account@gmail.com
# EMAIL_HOST_PASSWORD=ASK_PROJECT_OWNER_FOR_GMAIL_APP_PASSWORD

# Any other transactional SMTP provider also works. Example for Resend:
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.resend.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=resend
# EMAIL_HOST_PASSWORD=ASK_PROJECT_OWNER_FOR_SMTP_SECRET
# EMAIL_USE_TLS=true
# EMAIL_USE_SSL=false
# EMAIL_TIMEOUT=10
# DEFAULT_FROM_EMAIL=Paradise Kiss <lager@YOUR_VERIFIED_DOMAIN>
