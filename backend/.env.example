DJANGO_DEBUG=true
DJANGO_USE_SQLITE=false
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:4200
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:4200
DJANGO_SECURE_HSTS_SECONDS=0
APP_ALLOWED_USERNAMES=diego,nico,fabian
FRONTEND_URL=http://localhost:4200
PASSWORD_RESET_TIMEOUT=86400
SESSION_COOKIE_AGE=28800
DB_CONN_MAX_AGE=0
DB_POOL_MODE=transaction
DATABASE_URL=postgresql://postgres.PROJECT_REF:ROTATED_PASSWORD@POOLER_HOST:6543/postgres?sslmode=require
