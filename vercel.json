{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["dub1"],
  "services": {
    "frontend": {
      "root": ".",
      "framework": "angular",
      "buildCommand": "npm run build",
      "outputDirectory": "dist/paradise-kiss/browser",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    },
    "api": {
      "root": "backend",
      "framework": "django",
      "entrypoint": "backend/wsgi.py",
      "rewrites": [
        {
          "source": "/api/:path(.*)?",
          "destination": "/:path"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
